{
  "name": "copilot-hub-tools",
  "version": "1.0.0",
  "description": "Tools for managing GitHub Copilot templates",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "generate": "node dist/index.js",
    "generate-collection": "node dist/index.js",
    "generate-template-list": "node dist/index.js --template-list",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
