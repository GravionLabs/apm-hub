{
  "name": "apm-hub-tools",
  "version": "1.0.0",
  "packageManager": "pnpm@11.6.0",
  "description": "Generators and checks for the apm-hub skill packages",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "generate": "node dist/index.js",
    "generate:root-apm": "node dist/index.js --root-apm",
    "generate:ci": "node dist/index.js --aggregate",
    "generate:all": "npm run build && npm run generate:ci",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "test": "vitest run --project unit --project scripts",
    "test:all": "vitest run --project unit --project scripts --project integration",
    "test:perf": "vitest run --project perf --passWithNoTests",
    "test:unit": "vitest run --project unit",
    "test:related": "node scripts/run-related-tests.mjs",
    "test:ci": "vitest run --coverage --project unit --project scripts --project integration",
    "test:ci:project": "vitest run --coverage --passWithNoTests --project \"$PROJECT\"",
    "test:integration": "cd test/integration && npm install --silent && vitest run",
    "test:watch": "vitest",
    "check:manifests": "node scripts/check-manifests.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "ajv": "^8.20.0",
    "prettier": "^3.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  }
}
