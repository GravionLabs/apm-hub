# Node / JS
node_modules/
dist/
coverage/

# Python
.venv/
__pycache__/
*.pyc

# OS / IDE
.DS_Store
Thumbs.db

# VS Code - share launch and tasks configurations
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains IDEs - share run configurations
.idea/*
!.idea/runConfigurations/
!.idea/modules.xml
!.idea/vcs.xml
!.idea/codeStyles/
!.idea/*.iml

# Misc
*.log

# Test results
test-results/

# APM package cache — installed by `apm install`, not committed
packages/*/apm_modules/
apm_modules/

# Generated Copilot Hub runtime artifacts — deployed by `apm install` from root apm.yml
# Source of truth: templates/*/package.yml → packages/*/.apm/ → apm install → .github/
# Edit templates/, regenerate packages via CI, then apm install redeploys to .github/.
.github/agents/
.github/instructions/
.github/skills/
.github/plugin/

# Generated aggregate docs — managed by CI (regenerate-and-commit job)
# These are auto-generated from templates/ after merge to main.
# Edit generators in src/generators/, not these files.
docs/agent-list.md
docs/instruction-list.md
docs/skill-list.md
docs/template-list.md
/apm.lock.yaml
