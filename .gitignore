# Node / JS
node_modules/
dist/
coverage/

# Python
.venv/
__pycache__/
*.pyc

# OS / IDE
.DS_Store
Thumbs.db

# VS Code - share launch and tasks configurations
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code / OpenCode - local session state
.claude/

# JetBrains IDEs - share run configurations
.idea/*
!.idea/runConfigurations/
!.idea/modules.xml
!.idea/vcs.xml
!.idea/codeStyles/
!.idea/*.iml

# Misc
*.log

# Test results
test-results/

# APM package cache — installed by `apm install`, not committed
packages/*/apm_modules/
apm_modules/

# Deployed APM artifacts in package subdirectories — source of truth is .apm/
packages/*/.github/

# Generated aggregate docs — managed by CI (regenerate-and-commit job)
# They are regenerated from packages/ after merge to main.
# Edit generators in src/generators/, not these files.
docs/instruction-list.md
docs/skill-list.md
docs/agent-list.md
docs/template-list.md
/apm.lock.yaml
evals/results/

# VitePress site
site/.vitepress/cache/
site/.vitepress/dist/
