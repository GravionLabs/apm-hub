# Node / JS
node_modules/
dist/
coverage/

# Python
.venv/
__pycache__/
*.pyc

# OS / IDE
.DS_Store
Thumbs.db

# VS Code - share launch and tasks configurations
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains IDEs - share run configurations
.idea/*
!.idea/runConfigurations/
!.idea/modules.xml
!.idea/vcs.xml
!.idea/codeStyles/
!.idea/*.iml

# Misc
*.log

# Test results
test-results/

# Generated package distribution — managed by CI (regenerate-and-commit job)
# Source of truth: templates/*/package.yml (manifests in templates/)
# CI generates packages/ → .github/ + .apm/ + apm.yml
packages/
!packages/.gitkeep

# Generated Copilot Hub runtime artifacts — managed by CI
# Source of truth: templates/*/package.yml
# Edit manifests in templates/, not generated copies
.github/agents/
.github/instructions/
.github/skills/
.github/plugin/

# Legacy plugin artifacts (deprecated, use packages/ instead)
# Keeping for reference during migration
plugins/*/agents/
plugins/*/instructions/
plugins/*/skills/

# Generated aggregate docs — managed by CI (regenerate-and-commit job)
# These are auto-generated from templates/ after merge to main.
# Edit generators in src/generators/, not these files.
docs/agent-list.md
docs/instruction-list.md
docs/skill-list.md
docs/template-list.md
docs/plugin-list.md
