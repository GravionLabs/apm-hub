# Node / JS
node_modules/
dist/
coverage/

# Python
.venv/
__pycache__/
*.pyc

# OS / IDE
.DS_Store
Thumbs.db

# VS Code - share launch and tasks configurations
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains IDEs - share run configurations
.idea/*
!.idea/runConfigurations/
!.idea/modules.xml
!.idea/vcs.xml
!.idea/codeStyles/
!.idea/*.iml

# Misc
*.log

# Test results
test-results/

# Generated plugin artifacts — managed by CI (regenerate-and-commit job)
# Source of truth: templates/agents/, templates/instructions/, templates/skills/
# Edit templates, not these copies. CI regenerates them after merge to main.
plugins/*/agents/
plugins/*/instructions/
plugins/*/skills/

# Generated aggregate docs — managed by CI (regenerate-and-commit job)
# These are auto-generated from templates/ after merge to main.
# Edit generators in src/generators/, not these files.
docs/agent-list.md
docs/instruction-list.md
